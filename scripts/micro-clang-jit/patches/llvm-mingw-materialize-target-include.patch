diff --git a/build-mingw-w64.sh b/build-mingw-w64.sh
--- a/build-mingw-w64.sh
+++ b/build-mingw-w64.sh
@@ -110,7 +110,10 @@ if [ -z "$SKIP_INCLUDE_TRIPLET_PREFIX" ]; then
 
         mkdir -p "$PREFIX/$arch-w64-mingw32"
         if [ ! -e "$PREFIX/$arch-w64-mingw32/include" ]; then
-            ln -sfn ../generic-w64-mingw32/include "$PREFIX/$arch-w64-mingw32/include"
+            # The compiler is a native Windows executable. MSYS symlink
+            # semantics are not reliable for its target include lookup, so
+            # materialize the header tree for the controlled Windows build.
+            cp -a "$HEADER_ROOT/include" "$PREFIX/$arch-w64-mingw32/include"
         fi
     done
 fi
